# Arquivo Modelo para application.properties

# Copie este arquivo para application.properties e preencha suas credenciais

# 1. Nome da aplicação:
spring.application.name=Funcionario_Departamento

# 2. URL do Banco de Dados MySQL: protocolo://servidor:porta/nome_da_base?parâmetros
spring.datasource.url=jdbc:mysql://localhost:3306/seu_banco?serverTimezone=UTC

# 3. Credenciais de acesso locais ao MySQL:
spring.datasource.username= [usuário]
spring.datasource.password= [senha]

# 4. Estratégia de gerenciamento do schema pelo Hibernate:
# - 'update' cria ou atualiza tabelas conforme o mapeamento JPA. O banco/schema precisa existir.
# - 'validate' verifica se o schema existente é compatível com o mapeamento JPA, sem criar ou alterar tabelas.
spring.jpa.hibernate.ddl-auto=update

# 5. Exibição dos comandos SQL executados pelo Hibernate no console:
spring.jpa.show-sql=true
